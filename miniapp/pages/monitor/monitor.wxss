.container { padding: 24rpx; }
.logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  display: block;
}

.top-bar {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot.ok { background: #22c55e; }
.dot.off { background: #ef4444; }

.status-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.check-text {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: auto;
}

.hint {
  font-size: 24rpx;
  color: #94a3b8;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #475569;
  display: block;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.summary-bar {
  display: flex;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.summary-item { flex: 1; text-align: center; }

.summary-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.summary-label {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  text-transform: uppercase;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
}

.toggle-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.toggle-label {
  font-size: 24rpx;
  color: #475569;
}

.toggle-switch {
  width: 68rpx;
  height: 38rpx;
  background: #2563eb;
  border-radius: 19rpx;
  position: relative;
  transition: background 0.2s;
}

.toggle-switch.off { background: #cbd5e1; }

.toggle-knob {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 32rpx;
  height: 32rpx;
  background: #fff;
  border-radius: 50%;
  transition: transform 0.2s;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.15);
}

.toggle-switch.off .toggle-knob { transform: translateX(30rpx); }

.image-section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.result-image {
  width: 100%;
  border-radius: 8rpx;
  background: #f8fafc;
}

.no-image { padding: 60rpx; text-align: center; color: #94a3b8; }

.detection-section {
  background: #fff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.detection-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.detection-row:last-child { border-bottom: none; }

.detection-info { flex: 2; }

.detection-class {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.detection-box {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.conf-bar-wrap {
  flex: 3;
  height: 10rpx;
  background: #f1f5f9;
  border-radius: 5rpx;
  overflow: hidden;
}

.conf-bar { height: 100%; border-radius: 5rpx; }

.conf-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
  text-align: right;
}

.no-defects { padding: 40rpx; text-align: center; }
.no-defects-text { font-size: 28rpx; color: #94a3b8; }
